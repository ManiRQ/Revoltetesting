{
  "name": "todo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint src tests",
    "format:check": "prettier --check .",
    "check:syntax": "node --check src/app.js && node --check src/schemas.js && node --check src/server.js && node --check src/task-store.js && node --check tests/task-store.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
